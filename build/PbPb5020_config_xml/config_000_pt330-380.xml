<?xml version='1.0' encoding='utf-8'?>
<jetscape>
    <vlevel> 0 </vlevel>
    <nEvents>1000</nEvents>
    <setReuseHydro> true </setReuseHydro>
    <nReuseHydro>10</nReuseHydro>
    <Random>
        <seed>123</seed>
        </Random>
    <outputFilename>main-000-pt330-380</outputFilename>
    <JetScapeWriterFinalStateHadronsAscii> on </JetScapeWriterFinalStateHadronsAscii>
    <write_pthat> 1 </write_pthat>
    <IS>
        <initial_profile_path>./hydro_files_PbPb/cent_0_10</initial_profile_path>
        </IS>
    <Hard>
        <PythiaGun>
            <FSR_on>0</FSR_on>
            <pTHatMin>330</pTHatMin>
            <pTHatMax>380</pTHatMax>
            <eCM>5020</eCM>
            </PythiaGun>
        </Hard>
    <Preequilibrium>
        <NullPreDynamics> </NullPreDynamics>
        </Preequilibrium>
    <Hydro>
        <hydro_from_file>
            <name>Hydro from file</name>
            <read_in_multiple_hydro>1</read_in_multiple_hydro>
            <hydro_files_folder>./hydro_files_PbPb/cent_0_10</hydro_files_folder>
            <hydro_type>8</hydro_type>
            <T_c>0.1595</T_c>
            </hydro_from_file>
        </Hydro>
    <Eloss>
        <deltaT>0.1</deltaT>
        <formTime> -0.1 </formTime>
        <maxT>150</maxT>
        <tStart>0.5</tStart>
        <mutex>ON</mutex>
        <Matter>
            <name>Matter</name>
            <matter_on> 1 </matter_on>
            <Q0>2.0</Q0>
            <T0> 0.1595 </T0>
            <vir_factor> 0.25 </vir_factor>
            <in_vac> 0 </in_vac>
            <recoil_on> 1 </recoil_on>
            <broadening_on> 0 </broadening_on>
            <brick_med> 0 </brick_med>
            <brick_length> 5.0 </brick_length>
            <hydro_Tc> 0.1595 </hydro_Tc>
            <QhatParametrizationType> 6 </QhatParametrizationType>
            <alphas>0.4</alphas>
            <qhatA>10</qhatA>
            <qhatB>100</qhatB>
            <qhatC>0.2</qhatC>
            </Matter>
        <Lbt>
            <name> Lbt </name>
            <Q0>2.0</Q0>
            <in_vac> 0 </in_vac>
            <only_leading> 0 </only_leading>
            <hydro_Tc> 0.1595 </hydro_Tc>
            <alphas>0.4</alphas>
            <run_alphas>1</run_alphas>
            </Lbt>
        </Eloss>
    <JetHadronization>
        <name>colorless</name>
        <take_recoil>1</take_recoil>
        <eCMforHadronization>2510</eCMforHadronization>
        <LinesToRead>
            111:mayDecay = off
        </LinesToRead>
        </JetHadronization>
    </jetscape>
